
# https://github.com/camilb/kube-mysqldump-cron/blob/master/Docker/Dockerfile

# 使用 Debian 基础镜像，安装原版 MySQL 客户端
FROM debian:bullseye-slim

ARG APK_ARG=

# bullseye 已过 LTS 被归档，deb.debian.org 的 pool 中 .deb 已清理（构建时 404），改用 archive.debian.org 提供完整历史包
RUN sed -i 's/deb.debian.org/archive.debian.org/g' /etc/apt/sources.list && \
    apt-get update && apt-get install -y --no-install-recommends \
    default-mysql-client ca-certificates bash openssh-client sshpass procps ${APK_ARG} && \
    rm -rf /var/lib/apt/lists/*

ARG FILE_ARG=dump-import.sh
ENV ENTRYPOINT_RUN /$FILE_ARG

COPY $FILE_ARG /

# 支持异步并发执行，然后等待所有
ENV ASYNC_WAIT=""
# 最大进程数
ENV ASYNC_WAIT_MAX="100"

# 手动忽略的数据库
ENV IGNORE_DATABASE=""

# 手动忽略的数据库的表，多个逗号分割
ENV IGNORE_DATABASE_TABLES=""

ENV DB_HOST=""
ENV DB_NAME=""
ENV DB_PASS=""
ENV DB_USER=""

# ssh
ENV STRICT_HOST_KEY_CHECKING="no"
ENV SSH_ARGS=""
ENV SSH_PASSWORD=""
ENV SSH_USER=""
ENV SSH_IP=""

ENTRYPOINT ["/bin/sh", "-c", "$ENTRYPOINT_RUN"]
